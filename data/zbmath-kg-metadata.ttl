@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zbmath: <https://zbmath.org/> .
@prefix msc: <http://msc2010.org/resources/MSC/2010/> .
@prefix cito: <http://purl.org/spar/cito/> .

#################################################################
# DCAT CATALOG
#################################################################

<https://zbmath.org/catalog> a dcat:Catalog ;
    dcterms:title "zbMATH Open Knowledge Graph Catalog"@en ;
    dcterms:description "DCAT catalog describing the zbMATH Open Knowledge Graph dataset, including bibliographic metadata, MSC classifications, citations, and reviews."@en ;
    dcterms:publisher <https://zbmath.org/organization/zbmath> ;
    dcterms:language "en" ;
    dcat:dataset <https://zbmath.org/dataset/zbmath-kg> ;
    dcterms:issued "2026-01-01"^^xsd:date .

#################################################################
# DCAT DATASET
#################################################################

<https://zbmath.org/dataset/zbmath-kg> a dcat:Dataset, void:Dataset ;
    dcterms:title "zbMATH Open Knowledge Graph (Sample Extract)"@en ;
    dcterms:description "A Linked Open Data dataset representing bibliographic records from zbMATH Open, including scholarly articles, authors, journals, MSC 2010 classifications, keywords, citations, publishers, and reviews."@en ;
    dcterms:publisher <https://zbmath.org/organization/zbmath> ;
    dcterms:creator <https://zbmath.org/organization/zbmath> ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:language "en" ;
    dcterms:subject msc:05C12, msc:22D10, msc:43A90 ;
    dcat:keyword "mathematics", "bibliographic metadata", "MSC 2010", "citations", "knowledge graph", "linked data" ;
    dcat:theme <http://eurovoc.europa.eu/100277> ; # mathematics
    dcat:distribution <https://zbmath.org/dataset/zbmath-kg/distribution/rdf-turtle> ;
    dcterms:issued "2026-01-01"^^xsd:date ;
    dcterms:modified "2026-01-01"^^xsd:date ;

    #############################################################
    # VoID statistics
    #############################################################

    void:uriSpace "https://zbmath.org/" ;
    void:exampleResource zbmath:10000 ;
    void:triples 150 ;
    void:entities 50 ;
    void:classes 10 ;
    void:properties 35 ;

    void:vocabulary 
        <http://purl.org/dc/terms/> ,
        <http://www.w3.org/ns/dcat#> ,
        <http://rdfs.org/ns/void#> ,
        <http://schema.org/> ,
        <http://www.w3.org/2004/02/skos/core#> ,
        <http://purl.org/spar/cito/> ,
        <http://xmlns.com/foaf/0.1/> ;

    void:classPartition [
        void:class schema:ScholarlyArticle ;
        void:entities 2
    ] ,
    [
        void:class foaf:Person ;
        void:entities 3
    ] ,
    [
        void:class foaf:Organization ;
        void:entities 2
    ] ,
    [
        void:class skos:Concept ;
        void:entities 4
    ] ;

    void:propertyPartition [
        void:property dcterms:creator ;
        void:triples 4
    ] ,
    [
        void:property dcterms:subject ;
        void:triples 4
    ] ,
    [
        void:property cito:cites ;
        void:triples 6
    ] .

#################################################################
# DCAT DISTRIBUTION
#################################################################

<https://zbmath.org/dataset/zbmath-kg/distribution/rdf-turtle> a dcat:Distribution ;
    dcterms:title "zbMATH Open Knowledge Graph – RDF Turtle serialization"@en ;
    dcat:mediaType "text/turtle" ;
    dcat:accessURL <https://zbmath.org/dataset/zbmath-kg/download/zbmath-kg.ttl> ;
    dcat:downloadURL <https://zbmath.org/dataset/zbmath-kg/download/zbmath-kg.ttl> ;
    dcterms:format "text/turtle" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .

#################################################################
# PUBLISHER ORGANIZATION
#################################################################

<https://zbmath.org/organization/zbmath> a foaf:Organization ;
    foaf:name "zbMATH Open" ;
    foaf:homepage <https://zbmath.org/> .
