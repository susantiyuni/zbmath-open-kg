@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix zbmath: <https://zbmath.org/> .
@prefix msc: <http://msc2010.org/resources/MSC/2010/> .
@prefix cito: <http://purl.org/spar/cito/> .

#################################################################
# DCAT CATALOG
#################################################################

<https://zbmath.org/catalog> a dcat:Catalog ;
    dcterms:title "zbMATH Open Knowledge Graph Catalog"@en ;
    dcterms:publisher <https://zbmath.org/organization/zbmath> ;
    dcat:dataset <https://zbmath.org/dataset/zbmath-kg> .

#################################################################
# DATASET (DCAT + VoID)
#################################################################

<https://zbmath.org/dataset/zbmath-kg> a dcat:Dataset , void:Dataset ;

    dcterms:title "zbMATH Open Knowledge Graph"@en ;
    dcterms:description "A large-scale RDF knowledge graph generated from zbMATH Open JSONL records via an automated rdflib pipeline. It models scholarly articles, authors, reviewers, document types, MSC concepts, keyword concepts, periodicals, publishers, software, reviews, identifiers, and citation relations."@en ;

    dcterms:publisher <https://zbmath.org/organization/zbmath> ;
    dcterms:creator <https://zbmath.org/organization/zbmath> ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:language "en" ;

    #################################################################
    # GLOBAL GRAPH STATISTICS
    #################################################################

    void:triples 159154246 ;
    void:entities 36544981 ;
    void:distinctSubjects 17853081 ;
    void:properties 32 ;
    void:uriSpace "https://zbmath.org/" ;
    void:exampleResource zbmath:10000 ;

    #################################################################
    # VOCABULARIES USED
    #################################################################

    void:vocabulary 
        <http://purl.org/dc/terms/> ,
        <http://schema.org/> ,
        <http://www.w3.org/2004/02/skos/core#> ,
        <http://purl.org/spar/cito/> ,
        <http://xmlns.com/foaf/0.1/> ;

    #################################################################
    # CLASS PARTITIONS (exact core entities)
    #################################################################

    void:classPartition [
        void:class schema:ScholarlyArticle ;
        void:entities 4070393
    ] ,
    [
        void:class schema:Person ;
        void:entities 1125474
    ] ,
    [
        void:class schema:Review ;
        void:entities 3098767
    ] ,
    [
        void:class schema:SoftwareApplication ;
        void:entities 30857
    ] ,
    [
        void:class schema:Periodical ;
        void:entities 7350
    ] ,
    [
        void:class schema:Organization ;
        void:entities 3524
    ] ,
    [
        void:class zbmath:ontology/msc-concept ;
        void:entities 6734
    ] ,
    [
        void:class zbmath:ontology/keyword-concept ;
        void:entities 3008881
    ] ;

    #################################################################
    # PROPERTY PARTITIONS (major relations)
    #################################################################

    void:propertyPartition [
        void:property dcterms:creator
    ] ,
    [
        void:property dcterms:subject
    ] ,
    [
        void:property dcterms:isPartOf
    ] ,
    [
        void:property dcterms:publisher
    ] ,
    [
        void:property schema:identifier
    ] ,
    [
        void:property schema:review
    ] ,
    [
        void:property schema:software
    ] ,
    [
        void:property cito:cites
    ] .

#################################################################
# DISTRIBUTION
#################################################################

<https://zbmath.org/dataset/zbmath-kg/distribution/rdf-turtle> a dcat:Distribution ;
    dcat:mediaType "text/turtle" ;
    dcat:accessURL <https://zbmath.org/dataset/zbmath-kg/download/zbmath-kg.ttl> ;
    dcat:downloadURL <https://zbmath.org/dataset/zbmath-kg/download/zbmath-kg.ttl> ;
    dcterms:format "text/turtle" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .

#################################################################
# CONCEPT SCHEMES (as generated in script)
#################################################################

<https://zbmath.org/msc-scheme> a skos:ConceptScheme ;
    dcterms:title "Mathematics Subject Classification (MSC)" ;
    rdfs:label "MSC Classification" .

<https://zbmath.org/keyword-scheme> a skos:ConceptScheme ;
    dcterms:title "zbMATH Keyword Scheme" ;
    rdfs:label "zbMATH Keywords" .

#################################################################
# PUBLISHER
#################################################################

<https://zbmath.org/organization/zbmath> a foaf:Organization ;
    foaf:name "zbMATH Open" ;
    foaf:homepage <https://zbmath.org/> .

#################################################################
# ADDITIONAL GRAPH METRICS (custom extensions)
#################################################################

<https://zbmath.org/dataset/zbmath-kg>
    zbmath:numberOfTypedEntities "17853081"^^xsd:integer ;
    zbmath:entityTypeCoverage "0.4885"^^xsd:decimal ;
    zbmath:averageDegree "8.71"^^xsd:decimal ;
    zbmath:graphDensity "1.19E-7"^^xsd:double ;
    zbmath:temporalCoverageStart "1763"^^xsd:gYear ;
    zbmath:temporalCoverageEnd "2025"^^xsd:gYear .
