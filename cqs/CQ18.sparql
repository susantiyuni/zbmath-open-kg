#the authored paper was published after the reviewed paper, this better supports the narrative of intellectual influence.
PREFIX schema:   <https://schema.org/>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT
    ?reviewedTitle
    ?reviewYear
    ?authoredTitle
    ?authorYear
    ?keywordLabel

WHERE {

    # Hans L. Bodlaender reviews
    ?review a schema:Review ;
            schema:reviewer <https://zbmath.org/authors/bodlaender.hans-l> ;
            schema:itemReviewed ?reviewedPaper .

    ?reviewedPaper
        dcterms:issued ?reviewYear ;
        schema:name ?reviewedTitle ;
        schema:keywords ?keyword .

    FILTER(YEAR(?reviewYear) <= 2000)

    # Hans L. Bodlaender authored papers
    ?authoredPaper
        schema:author <https://zbmath.org/authors/bodlaender.hans-l> ;
        dcterms:issued ?authorYear ;
        schema:name ?authoredTitle ;
        schema:keywords ?keyword .

    FILTER(YEAR(?authorYear) >= 2000)
    FILTER(YEAR(?authorYear) <= 2025)

    ?keyword skos:prefLabel ?keywordLabel .

    FILTER(?reviewedPaper != ?authoredPaper)
}
ORDER BY ?reviewYear ?authorYear ?keywordLabel
