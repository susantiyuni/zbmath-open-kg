#Which controlled or curated keywords are associated with a given publication?
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT
    ?keyword
    ?keywordLabel

WHERE {
    <https://zbmath.org/1383556>
        schema:keywords ?keyword .

    ?keyword skos:prefLabel ?keywordLabel .
}
ORDER BY ?keywordLabel
