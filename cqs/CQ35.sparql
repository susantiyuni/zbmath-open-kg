PREFIX cito: <http://purl.org/spar/cito/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>


SELECT

    ?paper
    ?title
    ?year

    ?msc
    ?mscLabel

    (COUNT(DISTINCT ?citation) AS ?citations)

    (COUNT(DISTINCT ?review) AS ?reviews)

    (GROUP_CONCAT(
        DISTINCT ?keywordLabel;
        separator=", "
    ) AS ?keywords)


WHERE {


    ?paper a schema:ScholarlyArticle ;

           dcterms:title ?title ;

           dcterms:issued ?date ;

           dcterms:subject ?msc .


    BIND(YEAR(?date) AS ?year)


    ?msc skos:prefLabel ?mscLabel .


    OPTIONAL {

        ?paper cito:cites ?citation .

    }


    OPTIONAL {

        ?paper schema:review ?review .

    }


    OPTIONAL {

        ?paper schema:keywords ?keyword .

        ?keyword skos:prefLabel ?keywordLabel .

    }

}


GROUP BY
    ?paper
    ?title
    ?year
    ?msc
    ?mscLabel


ORDER BY ?year
