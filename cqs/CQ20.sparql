#Which publications were reviewed by a given reviewer, and when were those publications published?

PREFIX schema:  <https://schema.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT
    ?publication
    ?title
    ?year
    ?review
WHERE {
    ?review
        a schema:Review ;
        schema:reviewer <https://zbmath.org/authors/sessa.salvatore> ;
        schema:itemReviewed ?publication .

    ?publication
        schema:name ?title .

    OPTIONAL {
        ?publication dcterms:issued ?year .
    }
}
LIMIT 100
